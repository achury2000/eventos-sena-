# ---- Base de datos ----
POSTGRES_USER=sena
POSTGRES_PASSWORD=sena_dev
POSTGRES_DB=bienestar_sena
# En desarrollo local (app fuera de Docker): usa localhost.
# Si corres la app dentro de Docker (profile "full"), docker-compose.yml
# sobreescribe esta variable para usar el nombre de servicio "db".
DATABASE_URL=postgresql://sena:sena_dev@localhost:5432/bienestar_sena
# Base de datos dedicada del harness de testing (se recrea sola en cada corrida).
# Opcional: si se omite, los tests derivan bienestar_sena_test de DATABASE_URL.
# TEST_DATABASE_URL=postgresql://sena:sena_dev@localhost:5432/bienestar_sena_test

# ---- Almacenamiento de archivos (MinIO en desarrollo) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=firmas-digitales
S3_REGION=us-east-1

# ---- Autenticación (Auth.js v5) ----
AUTH_SECRET=reemplaza-esto-con-una-cadena-aleatoria-larga
AUTH_URL=http://localhost:3000

# ---- URL pública del sitio (para códigos QR) ----
# Base absoluta con la que se arman las URLs `/checkpoint/{codigoQr}` que
# codifican los QR impresos. Debe ser resoluble desde la red de los
# asistentes el día del evento (no localhost en producción).
NEXT_PUBLIC_URL=http://localhost:3000

# ---- Seed de datos iniciales ----
SEED_ADMIN_EMAIL=admin@sena.gov.co
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_DOCUMENTO=10000001
SEED_OPERADOR_EMAIL=operador@sena.gov.co
SEED_OPERADOR_PASSWORD=operador123
SEED_OPERADOR_DOCUMENTO=20000001

# ---- Rate limiting (Upstash Redis) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Correo transaccional (SMTP prioritario / Resend de respaldo) ----
# Prioridad: si existe al menos una variable SMTP_*, se usa SMTP. Si no existe
# ninguna, se usa Resend cuando RESEND_API_KEY y EMAIL_FROM estén completos.
# Sin transporte configurado el sistema NO envía correos y solo lo advierte una
# vez por proceso (falla abierta): así el desarrollo local y el CI no dependen
# de un proveedor.
#
# Si la configuración SMTP es parcial (por ejemplo, SMTP_HOST sin EMAIL_FROM o
# SMTP_USER sin SMTP_PASSWORD), NO se cae a Resend: se trata como no configurada
# y se advierte. Completa el bloque o deja todas las variables SMTP vacías.
#
# SMTP_PORT vacío usa 587; SMTP_SECURE vacío usa false (pon true para 465).
# SMTP_USER y SMTP_PASSWORD deben configurarse juntos o dejarse ambos vacíos.
# Algunos proveedores (p. ej. Office 365) exigen habilitar SMTP AUTH o usar una
# contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Remitente compartido por SMTP y Resend. Para Resend debe pertenecer a un
# dominio verificado.
EMAIL_FROM=Bienestar al Aprendiz <no-responder@example.com>
RESEND_API_KEY=
# Activa/desactiva la confirmación por correo tras una inscripción exitosa.
# Valor por defecto: false (seguro cuando no hay servicio de correo contratado).
# Acepta true/1/yes/on; cualquier otro valor (o ausente) la deja deshabilitada.
HABILITAR_CONFIRMACION_EVENTO=false
